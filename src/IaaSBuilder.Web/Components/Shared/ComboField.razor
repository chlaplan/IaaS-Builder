@*
    A combo that accepts values outside the catalog.

    The catalog snapshot can be stale or missing entirely in an air-gapped enclave, so the UI
    must never prevent an operator from typing a region or VM size it has not heard of. The
    legacy form bound dropdowns directly to live Get-AzVMSize output and offered nothing at all
    with no connection.
*@

@implements IDisposable
@inject ValidationState Validation

<div class="field">
    <label for="@_id">@Label</label>
    <input id="@_id"
           list="@_listId"
           type="text"
           value="@Value"
           class="@(Validation.HasError(Path) ? "invalid" : null)"
           aria-invalid="@(Validation.HasError(Path) ? "true" : null)"
           placeholder="@Placeholder"
           @onchange="OnChanged"
           disabled="@Disabled" />
    <datalist id="@_listId">
        @foreach (var option in Options)
        {
            <option value="@option"></option>
        }
    </datalist>
    <FieldIssues Path="@Path" Hint="@Hint" />
</div>

@code {
    private readonly string _id = $"f{Guid.NewGuid():N}";
    private readonly string _listId = $"l{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<string> Options { get; set; } = [];
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The dotted path the validator reports this value under.</summary>
    [Parameter] public string? Path { get; set; }

    protected override void OnInitialized() => Validation.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Validation.Changed -= Refresh;

    private Task OnChanged(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
